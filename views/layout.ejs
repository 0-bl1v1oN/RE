            <!-- Notifications menu -->
            <!-- 
            <li class="relative">

              <p class="text-sm">Logged as f*ck jarl software</p>

            </li>
            -->
            <!-- Profile menu -->
          </ul>
        </div>
      </header>
      <main class="h-full overflow-y-auto">

          <%- include(mainContent) %> <!-- Include the view specified by the mainContent variable -->
      
          


          </main>
    </div>
  </div>

  <script>
    ChangeLanguage(localStorage.getItem('language') || 'RU');

    function setTextIfExists(id, value)
    {
      const element = document.getElementById(id);
      if (element && value !== undefined) {
        element.textContent = value;
      }
    }

    function ApplyLayoutLanguage(lang)
    {
      if (!lang['layout']) return;

      const layout = lang['layout'];
      const textByBaseId = {
        'nav-radar': layout.radar,
        'nav-players': layout.players,
        'nav-resources': layout.resources,
        'nav-enemies': layout.enemies,
        'nav-chests': layout.chests,
        'nav-map': layout.map,
        'nav-ignorelist': layout.ignorelist,
        'nav-settings': layout.settings,
        'nav-launch-radar': layout.launchRadar,
        'nav-launch-items': layout.launchItems,
      };

      for (const [baseId, value] of Object.entries(textByBaseId)) {
        setTextIfExists(`${baseId}-1`, value);
        setTextIfExists(`${baseId}-2`, value);
        setTextIfExists(`${baseId}-3`, value);
      }

      setTextIfExists('nav-launch-radar-button', layout.launchRadar);
      setTextIfExists('nav-launch-items-button', layout.launchItems);
      setTextIfExists('language-label', layout.language);
      setTextIfExists('connection-status', layout.connected);
      setTextIfExists('pip-mode-button', isRadarPipOpen() ? layout.exitPip : layout.pipMode);
      document.title = layout.appTitle || 'AlbionRadar';
    }

    function ApplyPageLanguage(lang)
    {
      if (typeof SetLanguage === 'function') {
        SetLanguage(lang);
      }
    }

    function isRadarPipOpen()
    {
      return sessionStorage.getItem('radarPipOpen') === 'true';
    }

    async function ToggleRadarPip()
    {
      const nextOpenState = !isRadarPipOpen();
      const endpoint = nextOpenState ? '/pip/open' : '/pip/close';

        try {
        const response = await fetch(endpoint, { method: 'POST' });
        if (!response.ok) {
          throw new Error(`PiP request failed with status ${response.status}`);
        }

        sessionStorage.setItem('radarPipOpen', nextOpenState ? 'true' : 'false');
        ChangeLanguage(localStorage.getItem('language') || 'RU');
      } catch (error) {
        console.error('Failed to toggle PiP radar:', error);
      }
    }

    function ChangeLanguage(lang)
    {
      console.log(lang);
      switch (lang)
      {
        case 'RU':
          fetch('/scripts/Utils/languages/russian.json')
          .then((response) => response.json())
          .then((json) => {
            ApplyLayoutLanguage(json);
            ApplyPageLanguage(json);
          });
          localStorage.setItem('language', 'RU');
          break;

        case 'ID':
          fetch('/scripts/Utils/languages/indonesian.json')
          .then((response) => response.json())
          .then((json) => {
            ApplyLayoutLanguage(json);
            ApplyPageLanguage(json);
          });
          localStorage.setItem('language', 'ID');
          break;
      
        default:
        case 'EN':
          fetch('/scripts/Utils/languages/english.json')
          .then((response) => response.json())
          .then((json) => {
            ApplyLayoutLanguage(json);
            ApplyPageLanguage(json);
          });
          localStorage.setItem('language', 'EN');
          break;
      }
    }
  </script>

</body>
</html>

