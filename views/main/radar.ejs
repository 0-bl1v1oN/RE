<div class="container px-6 mx-auto grid radar-page">
  <section class="radar-card mt-4">
    <div class="radar-preview-wrap">
      <iframe
        class="radar-preview"
        src="/drawing?embedded=1"
        title="AlbionRadar preview"
      ></iframe>
    </div>

    <div class="radar-controls">
      <div class="radar-control-group">
        <span class="radar-muted">Отображение:</span>
        <label class="radar-inline-control">
          <input type="checkbox" checked>
          <span>Количество</span>
        </label>
        <label class="radar-inline-control">
          <input type="checkbox">
          <span>Дистанция</span>
        </label>
        <label class="radar-inline-control">
          <input type="checkbox">
          <span>Кластеры</span>
        </label>
      </div>

      <div class="radar-control-group">
        <span class="radar-muted">Масштаб:</span>
        <button class="radar-control-button" type="button">-</button>
        <input class="radar-range" type="range" min="40" max="120" value="60">
        <button class="radar-control-button" type="button">+</button>
        <span class="radar-value">60%</span>
        <button class="radar-reset" type="button">Сброс</button>
      </div>

      <div class="radar-control-group">
        <span class="radar-muted">Размер:</span>
        <button class="radar-control-button" type="button">-</button>
        <input class="radar-range" type="range" min="300" max="800" value="500">
        <button class="radar-control-button" type="button">+</button>
        <span class="radar-value">500px</span>
        <button class="radar-reset" type="button">Сброс</button>
      </div>

      <div class="radar-control-group">
        <span class="radar-muted">Иконки:</span>
        <button class="radar-control-button" type="button">-</button>
        <input class="radar-range" type="range" min="100" max="300" value="200">
        <button class="radar-control-button" type="button">+</button>
        <span class="radar-value">200%</span>
        <button class="radar-reset" type="button">Сброс</button>
      </div>
    </div>
  </section>

  <section class="radar-card players-panel">
    <div class="players-panel-title">
      <h2>Обнаруженные игроки</h2>
      <label class="radar-inline-control">
        <input type="checkbox" checked>
        <span>Показать</span>
      </label>
    </div>

    <div class="players-empty-state">
      <div class="players-loader"></div>
      <p>Игроки пока не обнаружены</p>
      <span>Сканирование ...</span>
    </div>
  </section>
</div>

